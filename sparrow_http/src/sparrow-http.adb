package body Sparrow.Http with SPARK_Mode is

   function Reason_Phrase (Status : Status_Code) return String is
     (case Status is
         when 100 => "Continue",
         when 101 => "Switching Protocols",
         when 200 => "OK",
         when 201 => "Created",
         when 202 => "Accepted",
         when 204 => "No Content",
         when 206 => "Partial Content",
         when 301 => "Moved Permanently",
         when 302 => "Found",
         when 303 => "See Other",
         when 304 => "Not Modified",
         when 307 => "Temporary Redirect",
         when 308 => "Permanent Redirect",
         when 400 => "Bad Request",
         when 401 => "Unauthorized",
         when 403 => "Forbidden",
         when 404 => "Not Found",
         when 405 => "Method Not Allowed",
         when 406 => "Not Acceptable",
         when 408 => "Request Timeout",
         when 409 => "Conflict",
         when 410 => "Gone",
         when 411 => "Length Required",
         when 412 => "Precondition Failed",
         when 413 => "Content Too Large",
         when 414 => "URI Too Long",
         when 415 => "Unsupported Media Type",
         when 416 => "Range Not Satisfiable",
         when 422 => "Unprocessable Content",
         when 426 => "Upgrade Required",
         when 428 => "Precondition Required",
         when 429 => "Too Many Requests",
         when 431 => "Request Header Fields Too Large",
         when 500 => "Internal Server Error",
         when 501 => "Not Implemented",
         when 502 => "Bad Gateway",
         when 503 => "Service Unavailable",
         when 504 => "Gateway Timeout",
         when others => "Unknown");

end Sparrow.Http;
