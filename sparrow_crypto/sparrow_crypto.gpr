with "sparrow_core.gpr";
with "config/sparrow_crypto_config.gpr";
project Sparrow_Crypto is

   for Library_Name use "Sparrow_Crypto";
   for Library_Version use Project'Library_Name & ".so." & Sparrow_Crypto_Config.Crate_Version;

   --  One body of Sparrow.Crypto.Random per platform.
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sparrow_Crypto_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPARROW_CRYPTO_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Sparrow_Crypto_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use ("-lssl", "-lcrypto");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sparrow_Crypto;
