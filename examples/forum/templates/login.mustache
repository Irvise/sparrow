{{> top}}
<form method="post" action="/login">
  <input type="hidden" name="csrf_token" value="{{csrf_token}}">
  <table width="100%" cellspacing="2" cellpadding="2" border="0" align="center">
    <tr><td align="left" class="nav"><a href="/" class="nav">Sparrow forum Forum Index</a></td></tr>
  </table>
  <table width="100%" cellpadding="4" cellspacing="1" border="0" class="forumline" align="center">
    <tr><th height="25" class="thHead" nowrap="nowrap" colspan="2">Please enter your username and password to log in</th></tr>
    {{#error}}
    <tr><td class="row3" colspan="2" align="center"><span class="gen error" role="alert">{{error}}</span></td></tr>
    {{/error}}
    <tr>
      <td class="row1" width="38%" align="right"><span class="gen">Username:</span></td>
      <td class="row2"><input type="text" class="post" name="name" size="25" value="{{name}}" autocomplete="username" required
          autofocus></td>
    </tr>
    <tr>
      <td class="row1" align="right"><span class="gen">Password:</span></td>
      <td class="row2"><input type="password" class="post" name="password" size="25" autocomplete="current-password" required></td>
    </tr>
    <tr>
      <td class="catBottom" colspan="2" align="center" height="28">
        <input type="submit" class="mainoption" value="Log in">
      </td>
    </tr>
  </table>
</form>
<p align="center"><span class="gensmall">New here? <a href="/register">Register</a>.</span></p>
{{> bottom}}
