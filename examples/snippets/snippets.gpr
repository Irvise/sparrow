with "../config/sparrow_examples_config.gpr";

--  The units SNIPPETS.md shows, compiled with warnings as errors and lines of 80 columns at most (as "alr init" crates check),
--  so that every snippet there builds as it is in a new crate. There is no
--  main: every source here is compiled. Built by generate.sh; not part of "alr build".
project Snippets is

   for Source_Dirs use ("src/");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use Sparrow_Examples_Config.Ada_Compiler_Switches & ("-gnatWb", "-gnatwe", "-gnatyM80");
   end Compiler;

end Snippets;
