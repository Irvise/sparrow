with "config/sparrow_tests_config.gpr";
with "sparrow_core.gpr";
with "sparrow_json.gpr";
with "sparrow_jwt.gpr";
with "sparrow_io.gpr";
with "sparrow_postgres.gpr";
with "sparrow_http.gpr";
with "sparrow_sqlite.gpr";
with "sparrow_templates.gpr";
with "sparrow_crypto.gpr";
with "sparrow_client.gpr";
with "sparrow_valkey.gpr";
with "sparrow_s3.gpr";
project Sparrow_Tests is

   for Source_Dirs use ("src/", "zlib/", "config/");
   for Object_Dir use "obj/" & Sparrow_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("core_tests.adb", "crypto_tests.adb", "json_tests.adb", "jwt_tests.adb", "io_tests.adb", "tls_tests.adb", "postgres_tests.adb", "http_tests.adb", "demo_server.adb", "sqlite_tests.adb", "template_tests.adb", "client_tests.adb", "telemetry_tests.adb", "log_writer.adb", "valkey_tests.adb", "s3_tests.adb", "http_2_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Sparrow_Tests_Config.Ada_Compiler_Switches & ("-gnata", "-gnatWb");   --  source bytes kept: UTF-8 literals stay UTF-8
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-lz");   --  zlib's inflate checks what Sparrow.Gzip writes (Zlib_Check)
   end Linker;

end Sparrow_Tests;
