with "sparrow_core.gpr";
with "config/sparrow_postgres_config.gpr";
project Sparrow_Postgres is

   for Library_Name use "Sparrow_Postgres";
   for Library_Version use Project'Library_Name & ".so." & Sparrow_Postgres_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Sparrow_Postgres_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPARROW_POSTGRES_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Sparrow_Postgres_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use ("-lpq");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Sparrow_Postgres;
